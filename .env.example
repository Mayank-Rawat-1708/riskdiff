# ---- Model providers ----
# At least one is required. The server builds its fallback chain from
# whichever of these are present, in this order: Groq -> OpenAI ->
# Anthropic. A provider with no key is skipped entirely rather than
# tried and failed.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Replaces the fallback chain entirely with a comma-separated
# list of provider:model ids, e.g.
#   MODEL_CHAIN=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
# Use it to pin a model when one starts misbehaving, or to exercise the
# weaker end of the chain — otherwise the first entry always answers and
# you only meet the fallbacks in an incident.
MODEL_CHAIN=

# ---- Git ----
# Leave GIT_REPO_URL empty to run in local-only mode: the workbench
# seeds a throwaway git repo from the agent/ directory and everything
# (branches, commits, reverts) works, it just never pushes anywhere.
# Set both to have approved changes pushed to a real GitHub repo.
GIT_REPO_URL=
GITHUB_PAT=

GIT_AUTHOR_NAME=Riska (RiskDiff agent)
GIT_AUTHOR_EMAIL=riska-agent@riskdiff.local

# ---- Server ----
PORT=8080
# Where the server keeps its working clone. On Render this must be a
# writable path; /tmp works, a mounted disk survives restarts.
RUNTIME_DIR=
AGENT_SUBDIR=agent
